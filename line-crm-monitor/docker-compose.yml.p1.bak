# =============================================================================
# 中央监控 Server —— 部署在用户本地电脑（非云服务器）
# 访问：
#   本机     http://localhost:${API_PORT}
#   局域网   http://<本机IP>:${API_PORT}
#   Tailscale http://<tailscale-ip>:${API_PORT}（宿主机入 tailnet 后即可）
# 不绑定公网域名/IP；具体访问方式部署阶段决定。
# =============================================================================
services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: monitor
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}
      POSTGRES_DB: monitor
      TZ: Asia/Taipei
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U monitor -d monitor"]
      interval: 5s
      timeout: 3s
      retries: 10
    # 数据库不对宿主机暴露端口，仅 api 内部访问

  api:
    build: .
    restart: unless-stopped
    environment:
      DATABASE_URL: postgresql://monitor:${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD in .env}@db:5432/monitor
      INGEST_TOKEN: ${INGEST_TOKEN:?set INGEST_TOKEN in .env}
      VIEW_TOKEN: ${VIEW_TOKEN:-}
      PORT: "8000"
      TZ: Asia/Taipei
    ports:
      - "${API_PORT:-8000}:8000"   # 默认绑 0.0.0.0，局域网/Tailscale 可访问
    depends_on:
      db:
        condition: service_healthy

  # P2：Vue Dashboard（构建产物由 api 静态托管，或独立 nginx 容器）
  # web:
  #   image: nginx:alpine
  #   volumes:
  #     - ./web/dist:/usr/share/nginx/html:ro
  #   ports:
  #     - "${WEB_PORT:-8080}:80"

volumes:
  pgdata:
