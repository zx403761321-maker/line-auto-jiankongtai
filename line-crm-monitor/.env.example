# 中央监控本地部署配置（复制为 .env 并填写）
POSTGRES_PASSWORD=change-me-db-password
INGEST_TOKEN=change-me-ingest-token
VIEW_TOKEN=
SESSION_SECRET=
# risk_status 判定阈值（读侧派生；默认 40/90）
RISK_WARNING_THRESHOLD=40
RISK_CRITICAL_THRESHOLD=90
API_PORT=8000
# server_id → 公网 IP 静态映射（JSON；新增服务器手动补充）
SERVER_IP_MAP={"JP-01":"151.158.0.122","JP-02":"23.27.52.210"}
# server_id → group_id 归属映射（JSON；未列出的服务器默认归 'default'）
SERVER_GROUP_MAP={"JP-01":"jp01-view"}
# events 保留天数（cleanup 后台任务按 event_type 清理；0=不清）
RETENTION_DEVICE_STATUS_DAYS=30
RETENTION_HEARTBEAT_DAYS=30
RETENTION_TASK_DAYS=90
# ── 权限底座（Stage7-E）────────────────────────────────
# admin 账号（seed 用；ADMIN_PASSWORD 留空则不创建 admin）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
# group 用户（JSON：{"用户名":{"password":"...","group_id":"default"}}）
# 命名约定（按服务器）：jp0X_viewer / jp0X_<公网IP> / jp0X-view（对应 SERVER_GROUP_MAP）
GROUP_USERS={"组长":{"password":"change-me","group_id":"default"}}
# 公网模式（Phase E/F 启用）：true 时启动强制 SESSION_SECRET≥32字符 + 至少一个登录账号；
# 同时 session cookie 强制 Secure（本地 http 直连将无法登录，须走 https）
PUBLIC_MODE=false
# tunn3l.sh 固定子域名（零注册/免费；公网地址 = https://<subdomain>.tunn3l.sh）
TUNN3L_SUBDOMAIN=line-monitor
